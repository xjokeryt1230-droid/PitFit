
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isParticipant(chatId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/chats/$(chatId)
        )
        && request.auth.uid in
          get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants;
    }

    // -------------------- PROFILE --------------------

    match /users/{userId} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName',
          'photoUrl',
          'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() <= 2048;

      allow delete: if false;

      // -------------------- NUTRITION GOALS --------------------

      match /settings/{settingId} {

        function validGoals(data) {
          return data.keys().hasOnly([
              'calories',
              'protein',
              'carbs',
              'fat',
              'updatedAt'
            ])
            && data.keys().hasAll([
              'calories',
              'protein',
              'carbs',
              'fat',
              'updatedAt'
            ])
            && data.calories is number
            && data.calories >= 0
            && data.calories <= 1000000
            && data.protein is number
            && data.protein >= 0
            && data.protein <= 1000000
            && data.carbs is number
            && data.carbs >= 0
            && data.carbs <= 1000000
            && data.fat is number
            && data.fat >= 0
            && data.fat <= 1000000
            && data.updatedAt == request.time;
        }

        function validProfile(data) {
          return data.keys().hasOnly([
              'age',
              'heightCm',
              'weightKg',
              'sexForFormula',
              'activity',
              'updatedAt'
            ])
            && data.keys().hasAll([
              'age',
              'heightCm',
              'weightKg',
              'sexForFormula',
              'activity',
              'updatedAt'
            ])
            && data.age is int
            && data.age >= 1
            && data.age <= 120
            && data.heightCm is number
            && data.heightCm > 0
            && data.heightCm <= 300
            && data.weightKg is number
            && data.weightKg > 0
            && data.weightKg <= 500
            && data.sexForFormula in ['male', 'female']
            && data.activity in ['low', 'light', 'moderate', 'high']
            && data.updatedAt == request.time;
        }

        allow get: if signedIn()
          && request.auth.uid == userId
          && settingId in ['nutritionGoals', 'nutritionProfile'];

        allow list: if false;

        allow create, update: if signedIn()
          && request.auth.uid == userId
          && (
            (
              settingId == 'nutritionGoals'
              && validGoals(request.resource.data)
            )
            ||
            (
              settingId == 'nutritionProfile'
              && validProfile(request.resource.data)
            )
          );

        allow delete: if signedIn()
          && request.auth.uid == userId
          && settingId == 'nutritionGoals';
      }

      // -------------------- NUTRITION --------------------

      match /nutritionEntries/{entryId} {

        function validEntry(data) {
          return data.keys().hasOnly([
              'name',
              'mealType',
              'portionGrams',
              'calories',
              'protein',
              'carbs',
              'fat',
              'consumedAt',
              'createdAt',
              'updatedAt'
            ])
            && data.keys().hasAll([
              'name',
              'mealType',
              'portionGrams',
              'calories',
              'protein',
              'carbs',
              'fat',
              'consumedAt',
              'createdAt',
              'updatedAt'
            ])
            && data.name is string
            && data.name.size() > 0
            && data.name.size() <= 120
            && data.mealType in [
              'Śniadanie',
              'Obiad',
              'Kolacja',
              'Przekąska'
            ]
            && data.portionGrams is number
            && data.portionGrams > 0
            && data.portionGrams <= 100000
            && data.calories is number
            && data.calories >= 0
            && data.calories <= 1000000
            && data.protein is number
            && data.protein >= 0
            && data.protein <= 1000000
            && data.carbs is number
            && data.carbs >= 0
            && data.carbs <= 1000000
            && data.fat is number
            && data.fat >= 0
            && data.fat <= 1000000
            && data.consumedAt is timestamp
            && data.createdAt is timestamp
            && data.updatedAt is timestamp;
        }

        allow get, list: if signedIn()
          && request.auth.uid == userId;

        allow create: if signedIn()
          && request.auth.uid == userId
          && validEntry(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if signedIn()
          && request.auth.uid == userId
          && validEntry(request.resource.data)
          && request.resource.data.createdAt
            == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        allow delete: if signedIn()
          && request.auth.uid == userId;
      }

      // -------------------- FRIEND LIST --------------------

      match /friends/{friendId} {
        allow get, list: if signedIn()
          && request.auth.uid == userId;

        allow create: if signedIn()
          && friendId != userId
          && request.resource.data.keys().hasOnly([
            'uid',
            'createdAt'
          ])
          && request.resource.data.uid == friendId
          && request.resource.data.createdAt == request.time
          && (
            (
              existsAfter(
                /databases/$(database)/documents/friendRequests/$(friendId + '_' + userId)
              )
              && getAfter(
                /databases/$(database)/documents/friendRequests/$(friendId + '_' + userId)
              ).data.fromUid == friendId
              && getAfter(
                /databases/$(database)/documents/friendRequests/$(friendId + '_' + userId)
              ).data.toUid == userId
              && getAfter(
                /databases/$(database)/documents/friendRequests/$(friendId + '_' + userId)
              ).data.status == 'accepted'
              && request.auth.uid == userId
            )
            ||
            (
              existsAfter(
                /databases/$(database)/documents/friendRequests/$(userId + '_' + friendId)
              )
              && getAfter(
                /databases/$(database)/documents/friendRequests/$(userId + '_' + friendId)
              ).data.fromUid == userId
              && getAfter(
                /databases/$(database)/documents/friendRequests/$(userId + '_' + friendId)
              ).data.toUid == friendId
              && getAfter(
                /databases/$(database)/documents/friendRequests/$(userId + '_' + friendId)
              ).data.status == 'accepted'
              && request.auth.uid == friendId
            )
          )
          && existsAfter(
            /databases/$(database)/documents/users/$(friendId)/friends/$(userId)
          );

        allow delete: if signedIn()
          && friendId != userId
          && (
            request.auth.uid == userId
            || request.auth.uid == friendId
          )
          && exists(
            /databases/$(database)/documents/users/$(friendId)/friends/$(userId)
          )
          && !existsAfter(
            /databases/$(database)/documents/users/$(friendId)/friends/$(userId)
          );

        allow update: if false;
      }
    }

    // -------------------- FRIEND CODES --------------------

    match /friendCodes/{code} {
      allow get: if signedIn();

      allow list: if signedIn()
        && resource.data.uid == request.auth.uid;

      allow create: if signedIn()
        && !exists(
          /databases/$(database)/documents/friendCodes/$(code)
        )
        && request.resource.data.keys().hasOnly([
          'uid',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && code.matches('PF[A-HJ-NP-Z2-9]{6}')
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // -------------------- FRIEND REQUESTS --------------------

    match /friendRequests/{requestId} {
      allow get: if signedIn()
        && (
          !exists(
            /databases/$(database)/documents/friendRequests/$(requestId)
          )
          || resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid
        );

      allow list: if signedIn()
        && (
          resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid
        );

      allow create: if signedIn()
        && requestId ==
          request.resource.data.fromUid + '_' +
          request.resource.data.toUid
        && request.resource.data.keys().hasOnly([
          'fromUid',
          'toUid',
          'status',
          'createdAt'
        ])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && exists(
          /databases/$(database)/documents/users/$(request.resource.data.toUid)
        )
        && !exists(
          /databases/$(database)/documents/users/$(request.auth.uid)/friends/$(request.resource.data.toUid)
        )
        && !exists(
          /databases/$(database)/documents/users/$(request.resource.data.toUid)/friends/$(request.auth.uid)
        )
        && !(
          exists(
            /databases/$(database)/documents/friendRequests/$(request.resource.data.toUid + '_' + request.resource.data.fromUid)
          )
          && get(
            /databases/$(database)/documents/friendRequests/$(request.resource.data.toUid + '_' + request.resource.data.fromUid)
          ).data.status == 'pending'
        );

      allow update: if signedIn()
        && (
          (
            resource.data.toUid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.fromUid == resource.data.fromUid
            && request.resource.data.toUid == resource.data.toUid
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.keys().hasOnly([
              'fromUid',
              'toUid',
              'status',
              'createdAt',
              'respondedAt'
            ])
            && request.resource.data.status in [
              'accepted',
              'rejected'
            ]
            && request.resource.data.respondedAt == request.time
            && (
              request.resource.data.status == 'rejected'
              || (
                existsAfter(
                  /databases/$(database)/documents/users/$(resource.data.fromUid)/friends/$(resource.data.toUid)
                )
                && existsAfter(
                  /databases/$(database)/documents/users/$(resource.data.toUid)/friends/$(resource.data.fromUid)
                )
                && getAfter(
                  /databases/$(database)/documents/users/$(resource.data.fromUid)/friends/$(resource.data.toUid)
                ).data.uid == resource.data.toUid
                && getAfter(
                  /databases/$(database)/documents/users/$(resource.data.toUid)/friends/$(resource.data.fromUid)
                ).data.uid == resource.data.fromUid
              )
            )
          )
          ||
          (
            resource.data.fromUid == request.auth.uid
            && resource.data.status in [
              'accepted',
              'rejected'
            ]
            && request.resource.data.fromUid == resource.data.fromUid
            && request.resource.data.toUid == resource.data.toUid
            && request.resource.data.status == 'pending'
            && request.resource.data.createdAt == request.time
            && request.resource.data.keys().hasOnly([
              'fromUid',
              'toUid',
              'status',
              'createdAt'
            ])
          )
        );

      allow delete: if false;
    }

    // -------------------- CHATS --------------------

    match /chats/{chatId} {

      function isGroup() {
        return resource.data.type == 'group';
      }

      function isAdmin() {
        return signedIn()
          && request.auth.uid in resource.data.participants
          && request.auth.uid in resource.data.admins;
      }

      function validChatTimestamp() {
        return request.resource.data.updatedAt == request.time;
      }

      function validMessageUpdate() {
        return request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              'lastMessage',
              'updatedAt'
            ])
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() <= 4000
          && validChatTimestamp();
      }

      // Każdy uczestnik może dodać znajomego.
      function validGroupMemberAdd() {
        let oldMembers = resource.data.participants;
        let newMembers = request.resource.data.participants;
        let addedUid = request.resource.data.lastMemberAddedUid;

        return isGroup()
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                'participants',
                'lastMemberAddedBy',
                'lastMemberAddedUid',
                'updatedAt'
              ])
          && newMembers is list
          && newMembers.size() == oldMembers.size() + 1
          && newMembers.hasAll(oldMembers)
          && addedUid is string
          && addedUid != request.auth.uid
          && addedUid in newMembers
          && request.resource.data.lastMemberAddedBy == request.auth.uid
          && request.resource.data.admins == resource.data.admins
          && newMembers.size() <= 100
          && exists(
            /databases/$(database)/documents/users/$(request.auth.uid)/friends/$(addedUid)
          )
          && validChatTimestamp();
      }
      // -------------------- GROUP EVENTS --------------------

      match /events/{eventId} {
        function validEvent() {
          return request.resource.data.keys().hasOnly([
              'type',
              'actorUid',
              'targetUid',
              'createdAt'
            ])
            && request.resource.data.keys().hasAll([
              'type',
              'actorUid',
              'createdAt'
            ])
            && request.resource.data.type in [
              'group_created',
              'member_added',
              'member_removed',
              'admin_promoted',
              'admin_demoted',
              'member_left'
            ]
            && request.resource.data.actorUid == request.auth.uid
            && request.resource.data.createdAt == request.time
            && (
              !('targetUid' in request.resource.data)
              || request.resource.data.targetUid is string
            );
        }

        allow read: if isParticipant(chatId);

        allow create: if signedIn()
          && validEvent()
          && (
            isParticipant(chatId)
            || request.resource.data.type == 'member_left'
          );

        allow update, delete: if false;
      }
      // Administrator może usunąć jednego członka.
      function validGroupMemberRemoval() {
        let oldMembers = resource.data.participants;
        let newMembers = request.resource.data.participants;
        let oldAdmins = resource.data.admins;
        let newAdmins = request.resource.data.admins;

        return isGroup()
          && isAdmin()
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                'participants',
                'admins',
                'updatedAt'
              ])
          && newMembers is list
          && newAdmins is list
          && newMembers.size() == oldMembers.size() - 1
          && oldMembers.hasAll(newMembers)
          && oldAdmins.hasAll(newAdmins)
          && (
            newAdmins == oldAdmins
            || (
              newAdmins.size() == oldAdmins.size() - 1
              && newAdmins.size() >= 1
            )
          )
          && newMembers.hasAll(newAdmins)
          && validChatTimestamp();
      }

      // Nadanie uprawnień administratora.
      function validAdminChange() {
        let oldAdmins = resource.data.admins;
        let newAdmins = request.resource.data.admins;

        return isGroup()
          && isAdmin()
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                'admins',
                'updatedAt'
              ])
          && newAdmins is list
          && newAdmins.size() == oldAdmins.size() + 1
          && newAdmins.hasAll(oldAdmins)
          && resource.data.participants.hasAll(newAdmins)
          && validChatTimestamp();
      }

      // Odebranie uprawnień innemu administratorowi.
      function validAdminRemoval() {
        let oldAdmins = resource.data.admins;
        let newAdmins = request.resource.data.admins;

        return isGroup()
          && isAdmin()
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                'admins',
                'updatedAt'
              ])
          && newAdmins is list
          && newAdmins.size() == oldAdmins.size() - 1
          && oldAdmins.hasAll(newAdmins)
          && newAdmins.size() >= 1
          && resource.data.participants.hasAll(newAdmins)
          && newAdmins.hasAny([request.auth.uid])
          && validChatTimestamp();
      }

      // Członek opuszcza grupę.
      function validLeaveGroup() {
        let oldMembers = resource.data.participants;
        let newMembers = request.resource.data.participants;
        let oldAdmins = resource.data.admins;
        let newAdmins = request.resource.data.admins;

        return isGroup()
          && request.auth.uid in oldMembers
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                'participants',
                'admins',
                'updatedAt'
              ])
          && newMembers is list
          && newAdmins is list
          && newMembers.size() == oldMembers.size() - 1
          && oldMembers.hasAll(newMembers)
          && !newMembers.hasAny([request.auth.uid])
          && newMembers.hasAll(newAdmins)
          && (
            (
              oldAdmins.hasAny([request.auth.uid])
              && oldAdmins.size() > 1
              && oldAdmins.hasAll(newAdmins)
              && newAdmins.size() == oldAdmins.size() - 1
              && !newAdmins.hasAny([request.auth.uid])
            )
            ||
            (
              !oldAdmins.hasAny([request.auth.uid])
              && newAdmins == oldAdmins
            )
          )
          && validChatTimestamp();
      }

      allow get: if signedIn()
        && (
          !exists(
            /databases/$(database)/documents/chats/$(chatId)
          )
          || request.auth.uid in resource.data.participants
        );

      allow list: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 100
        && request.resource.data.lastMessage == ''
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.type == 'private'
            && request.resource.data.participants.size() == 2
          )
          ||
          (
            request.resource.data.type == 'group'
            && request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.admins is list
            && request.auth.uid in request.resource.data.admins
          )
        );

      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && (
          validMessageUpdate()
          || validGroupMemberAdd()
          || validGroupMemberRemoval()
          || validAdminChange()
          || validAdminRemoval()
          || validLeaveGroup()
        );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(chatId);

        allow create: if isParticipant(chatId)
          && request.resource.data.keys().hasOnly([
            'senderId',
            'text',
            'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}
